{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/venv/Scripts/python.exe"
      },
      "osx": {
        "python": "${workspaceFolder}/venv/bin/python"
      },
      "linux": {
        "python": "${workspaceFolder}/venv/bin/python"
      },
      "module": "uvicorn",
      "args": [
        "api.main:app",
        "--host", "0.0.0.0",
        "--port", "8767",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Electron",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/electron/cli.js",
      "args": ["."],
      "env": {
        "DEV_MODE": "true"
      },
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Debug SlideControl V3 (F5)",
      "configurations": ["Python: FastAPI", "Electron"],
      "stopAll": true
    }
  ]
}
